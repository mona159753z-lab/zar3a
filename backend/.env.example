# انسخ الملف ده باسم .env وحط المفتاح
# من غير مفتاح = صوت المتصفح تلقائيًا. تقدري تثبّت الوضع:
# VOICE_MODE=browser   (browser | api | auto)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# STT_MODEL=gpt-4o-transcribe
# LLM_MODEL=gpt-4o-mini
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
DATABASE_URL=sqlite:///./zar3a.db
CORS_ORIGINS=*

# موديل احتياطي لو الأساسي وصل للحد (429). اسمه من لوحة Groq:
# LLM_FALLBACK_MODEL=

# --- صوت مصري من Hugging Face (سيرفر منفصل، شوف hf_voice_server/server.py) ---
# HF_TTS_URL=http://127.0.0.1:8001
# TTS_PROVIDER=hf          (hf بيجرّب الموديل وبعدين Edge لو وقع)
# HF_TTS_SPEAKER=Yasmin
# HF_TTS_STEPS=16
